TOOL_DATABASE_PATH="./.data/tool.sqlite"
TOOL_YJS_DATABASE_PATH="./.data/collaboration.sqlite"
TOOL_ALLOWED_ORIGINS="http://localhost:3000"
TOOL_PAGE_SESSION_SECRET="replace-with-a-long-random-secret"
TOOL_ASSET_DIR="./.data/assets"

# Optional GitHub OAuth. When unset, auth UI is hidden and anonymous page
# creation works exactly as before.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Public GIF search integration key. The browser uses this to call GIPHY.
GIPHY_API_KEY=""

# MCP endpoint. Remote requests require scoped bearer tokens minted per page.
TOOL_MCP_ENABLED="false"
TOOL_MCP_ALLOW_ANONYMOUS="false"
TOOL_MCP_RATE_LIMIT_MAX="60"
TOOL_MCP_RATE_LIMIT_WINDOW_MS="60000"
TOOL_MCP_READ_RATE_LIMIT_MAX="120"
TOOL_MCP_READ_RATE_LIMIT_WINDOW_MS="60000"
TOOL_MCP_SUGGEST_RATE_LIMIT_MAX="30"
TOOL_MCP_SUGGEST_RATE_LIMIT_WINDOW_MS="60000"
TOOL_MCP_WRITE_RATE_LIMIT_MAX="20"
TOOL_MCP_WRITE_RATE_LIMIT_WINDOW_MS="60000"

# GLM / Z.AI OpenAI-compatible chat completions.
# Set GLM_API_KEY or ZAI_API_KEY in your local/hosted secret store.
GLM_API_KEY=""
GLM_BASE_URL="https://api.z.ai/api/paas/v4"
GLM_MODEL="glm-5.2"
GLM_TIMEOUT_MS="20000"
